<.header>
  {dgettext("specialities", "Listing Specialities")}
  <:actions>
    <.link patch={~p"/admin/specialities/new"}>
      <.button>{dgettext("specialities", "New Speciality")}</.button>
    </.link>
  </:actions>
</.header>

<.flop_table
  id="specialities"
  items={@streams.specialities}
  meta={@meta}
  path={~p"/admin/specialities"}
  row_click={fn {_id, speciality} -> JS.navigate(~p"/admin/specialities/#{speciality}") end}
>
  <:col :let={{_, speciality}} label={dgettext("specialities", "Id")} field={:id}>
    {speciality.id}
  </:col>

  <:col :let={{_id, speciality}} label={dgettext("specialities", "Code")} field={:code}>
    {speciality.code}
  </:col>
  <:col :let={{_id, speciality}} label={dgettext("specialities", "Title")} field={:title}>
    {speciality.title}
  </:col>

  <:action :let={{_id, speciality}}>
    <div class="sr-only">
      <.link navigate={~p"/admin/specialities/#{speciality}"}>
        {dgettext("specialities", "Show")}
      </.link>
    </div>
    <.link patch={~p"/admin/specialities/#{speciality}/edit"}>
      {dgettext("specialities", "Edit")}
    </.link>
  </:action>
  <:action :let={{id, speciality}}>
    <.link
      phx-click={JS.push("delete", value: %{id: speciality.id}) |> hide("##{id}")}
      data-confirm={dgettext("specialities", "Are you sure?")}
    >
      {dgettext("specialities", "Delete")}
    </.link>
  </:action>
</.flop_table>

<.flop_pagination meta={@meta} path={~p"/admin/specialities"} />

<.modal
  :if={@live_action in [:new, :edit]}
  id="speciality-modal"
  show
  on_cancel={JS.patch(~p"/admin/specialities")}
>
  <:title>{@page_title}</:title>
  <.live_component
    module={EcampusWeb.SpecialityLive.FormComponent}
    id={@speciality.id || :new}
    action={@live_action}
    speciality={@speciality}
    patch={~p"/admin/specialities"}
  />
</.modal>
